# Rajasthan Tourism Experience — Environment Configuration
# Note: The current application is a client-side architectural travel discovery platform
# and parametric itinerary planner. It does not invoke a backend API or server-side Gemini service.
# Therefore, GEMINI_API_KEY is NOT required for the application to function.
# No secrets or private keys are exposed to the client-side browser bundle.

# APP_URL: The URL where this applet is hosted (provided by the container environment).
APP_URL="http://localhost:3000"
